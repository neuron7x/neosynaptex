{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "schemas/claim_card.schema.json", "type": "object", "additionalProperties": false, "required": ["claim_id", "claim_text", "claim_type"], "properties": {"claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"}, "claim_text": {"type": "string"}, "claim_type": {"type": "string", "enum": ["factual", "causal", "predictive", "software", "methodological", "statistical", "security", "operational", "theoretical", "compliance"]}}}