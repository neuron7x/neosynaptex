{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "schemas/kill_artifact.schema.json", "type": "object", "additionalProperties": false, "required": ["artifact_id", "status", "claim_id", "kill_reason", "future_guardrail", "artifact_hash", "integration_permission"], "properties": {"artifact_id": {"type": "string", "pattern": "^KILL-[0-9]{6}$"}, "status": {"type": "string", "enum": ["EVIDENCE", "KILLED", "QUARANTINED"]}, "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"}, "kill_reason": {"type": "string", "minLength": 1}, "future_guardrail": {"type": "string", "minLength": 1}, "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "integration_permission": {"const": false}}}