{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "schemas/evidence_artifact.schema.json", "type": "object", "additionalProperties": false, "required": ["artifact_id", "status", "claim_id", "boundary_id", "reproducibility_manifest", "artifact_hash", "integration_permission"], "properties": {"artifact_id": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}, "status": {"type": "string", "enum": ["EVIDENCE", "KILLED", "QUARANTINED"]}, "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"}, "boundary_id": {"type": "string", "pattern": "^BND-[0-9]{6}$"}, "reproducibility_manifest": {"type": "object"}, "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "integration_permission": {"const": true}}}