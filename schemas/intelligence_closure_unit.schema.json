{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "schemas/intelligence_closure_unit.schema.json", "type": "object", "additionalProperties": false, "required": ["icu_id", "status", "retention_hash"], "properties": {"icu_id": {"type": "string", "pattern": "^ICU-[0-9]{6}$"}, "status": {"type": "string", "enum": ["EVIDENCE", "KILLED", "QUARANTINED"]}, "retention_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}