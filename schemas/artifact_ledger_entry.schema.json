{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "schemas/artifact_ledger_entry.schema.json", "type": "object", "additionalProperties": false, "required": ["ledger_id", "status", "artifact_hash"], "properties": {"ledger_id": {"type": "string", "pattern": "^LEDGER-[0-9]{6}$"}, "status": {"type": "string", "enum": ["EVIDENCE", "KILLED", "QUARANTINED"]}, "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}